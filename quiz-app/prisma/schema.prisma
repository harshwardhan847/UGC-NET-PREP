datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Question {
  id          String    @id
  year        String
  paper       String
  q_num       Int
  question    String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  answer      String
  solution    String
  unit        Int
  unitName    String
  conceptName String
  attempts    Attempt[]
  bookmark    Bookmark?
}

model Attempt {
  id          String       @id @default(uuid())
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswer  String
  isCorrect   Boolean
  createdAt   DateTime     @default(now())
  sessionId   String?
  session     QuizSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timeSpent   Int?         // seconds spent on the question before answering
  source      String?      // "quiz", "swipe", "weightage", "repeats", "bank"

  @@index([questionId, createdAt])
  @@index([createdAt])
}

model QuizSession {
  id          String    @id @default(uuid())
  date        DateTime  @default(now())
  mode        String    // "practice", "mock", "custom", "smart", "review"
  title       String?
  unit        Int?
  unitName    String?
  paper       String?
  score       Int
  total       Int
  duration    Int?      // seconds
  attempts    Attempt[]
}

model Bookmark {
  questionId  String   @id
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  note        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
