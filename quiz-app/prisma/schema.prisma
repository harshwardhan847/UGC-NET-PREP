datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Question {
  id          String    @id
  year        String
  paper       String
  q_num       Int
  question    String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  answer      String
  solution    String
  unit        Int
  unitName    String
  conceptName String
  attempts    Attempt[]
}

model Attempt {
  id          String       @id @default(uuid())
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswer  String
  isCorrect   Boolean
  createdAt   DateTime     @default(now())
  sessionId   String?
  session     QuizSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model QuizSession {
  id          String    @id @default(uuid())
  date        DateTime  @default(now())
  mode        String    // "practice", "mock", "custom"
  unit        Int?
  unitName    String?
  score       Int
  total       Int
  attempts    Attempt[]
}
